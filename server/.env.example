# ---- Discover Nepal server ----
# Copy to .env and adjust.

# HTTP port for the Express API
PORT=5001

# MongoDB connection string (local dev default)
MONGODB_URI=mongodb://127.0.0.1:27017/discover-nepal

# JWT signing secret — CHANGE THIS in production
JWT_SECRET=change-me-to-a-long-random-string

# JWT expiry (e.g. 7d, 24h)
JWT_EXPIRES_IN=7d

# Client origin allowed by CORS (comma-separated list ok)
CLIENT_ORIGIN=http://localhost:5173